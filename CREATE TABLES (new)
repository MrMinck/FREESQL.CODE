TABELA TURMA

CREATE TABLE turma (
    id_turma NUMBER PRIMARY KEY,
    nome_turma VARCHAR2(100) NOT NULL,
    ano_letivo NUMBER(4) NOT NULL,
    id_professor NUMBER,
    CONSTRAINT fk_professor FOREIGN KEY (id_professor) REFERENCES professor(id_professor)
);

